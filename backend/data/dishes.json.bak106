    "medicinal_ingredients": [],
    "cooking_method": "凉拌",
    "cooking_steps": [
      "马兰头洗净，沸水焯烫1分钟捞出过凉水",
      "挤干水分切碎，香干切碎",
      "加调料拌匀装盘即可"
    ],
    "skills": "马兰头焯水时间不宜过长，保持翠绿；挤干水分才香；糖少许提鲜不要吃出甜味。",
    "efficacy_chinese": "清热解毒，凉血止血，清肝明目，春季时令野菜，疏肝降火。",
    "nutrition_info": "马兰头富含维生素A、维生素C、胡萝卜素、钾钙铁等矿物质，高纤维低热量，春季食用可补充维生素，清热降火。",
    "suitable_constitutions": [
      "湿热质",
      "阴虚质",
      "平和质",
      "气郁质"
    ],
    "suitable_seasons": [
      "春季",
      "立春",
      "雨水",
      "惊蛰",
      "春分",
      "清明",
      "谷雨"
    ],
    "contraindication": "脾胃虚寒者不宜多食；女性经期少食。",
    "appearance_standard": "色泽翠绿，清香爽口，摆盘整洁",
    "flavor": "清淡鲜香",
    "is_medicinal": 0,
    "story": "马兰头是江南春季著名野菜，清明前后采食，有'春季第一野菜'之称，是立春至清明的时令珍馐。",
    "id": 1
