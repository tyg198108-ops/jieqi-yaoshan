  {
    "name": "韭菜",
    "alias": "起阳草",
    "category": "温阳类",
    "four_natures": "温",
    "five_flavors": [
      "辛"
    ],
    "meridian_tropism": [
      "肝",
      "胃",
      "肾"
    ],
    "efficacy_chinese": "温中，下气，补虚，调和腑脏，令人能食，益阳。用于噎膈反胃，自汗盗汗，消渴，痔漏，脱肛，跌打损伤。",
    "nutrition_info": "富含膳食纤维、硫化物、维生素C、锌，温肾壮阳，促进肠道蠕动，散瘀活血。",
    "suitable_seasons": [
      "春季",
      "冬季"
    ],
    "suitable_constitutions": [
      "阳虚质",
      "平和质"
    ],
    "contraindication": "阴虚内热及疮疡、目疾患者忌食；胃虚有热、消化不良者不宜多食。",
    "dosage": "适量，鲜品100-200g",
    "cooking_methods": [
      "炒、煮"
    ],
    "good_combinations": [
      "核桃、鸡蛋、虾仁"
    ],
    "bad_combinations": [
      "蜂蜜（古籍记载相反）、牛肉"
    ],
    "in_catalog": 1,
    "description": "春食则香，夏食则臭，春季韭菜最鲜美，起阳草，温补肾阳。",
    "is_medicinal": 1,
    "source_lesson": null,
    "source": "legacy",
    "catalog_note": "胡老师核定：计入药食同源目录（2026-09-23 批量确认）",
